OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase project (Settings > API in the Supabase dashboard). Required for
# the app/api routes to read/write real data instead of the mock data layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses row-level security. Never exposed to the client and
# never prefixed NEXT_PUBLIC_. Only needed for writes the anon key can't do.
SUPABASE_SERVICE_ROLE_KEY=

# World Air Quality Index (aqicn.org) feed token: https://aqicn.org/data-platform/token/
# Current-conditions only for one fixed coordinate, server-only.
WAQI_API_TOKEN=
